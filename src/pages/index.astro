---
// 文章列表已移至 /chronicle（班史列表页），首页编年史区块留空
import { SITE, HOME } from "../site.config";
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{SITE.className} · 班史</title>
        <meta name="description" content={HOME.description} />
        <meta property="og:title" content={`${SITE.className} · 班史`} />
        <meta property="og:description" content={HOME.description} />
        <meta property="og:type" content="website" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="stylesheet" href="/css/index.css" />
    </head>

    <body>
        <!-- <Header /> -->
        <canvas id="stars"></canvas>
        <div class="glow g1"></div>
        <div class="glow g2"></div>
        <div class="glow g3"></div>
        <div id="progress"></div>
        <!-- ========== 页眉 ========== -->
        <header class="topbar" id="topbar">
            <a class="brand" href="/">
                <span class="brand-mark">{SITE.brandMark}</span>
                <span class="brand-text">{SITE.className} · 班史</span>
            </a>

            <nav class="topnav" aria-label="页面导航">
                <a class="nav-cta" href="#board">留言</a>
                <a class="nav-cta" href="/music">♫ 歌单</a>
                <a class="nav-cta" href="/chronicle">📖 班史列表</a>
                <a class="nav-cta" href="/contribute">📝 投稿</a>
            </nav>
        </header>
        <div class="wrap">
            <!-- ========== 首屏 ========== -->
            <header class="hero">
                <div class="hero-badge">{SITE.heroBadge}</div>
                <h1>{SITE.className}</h1>
                <p class="sub">
                    <span id="typed"></span><i class="cursor"></i>
                </p>
                <div class="hero-line"></div>
                <a class="hero-cta" href="/chronicle">📖 打开班史列表</a>
            </header>
            <!-- ========== 班级简介 ========== -->
            <section id="about">
                <div class="container">
                    <div class="intro-grid">
                        <div class="intro-text reveal">
                            <span class="sec-tag">About Us</span>
                            <h2 class="sec-title">
                                一间教室，<em>三年光阴</em>
                            </h2>
                            {HOME.intro.map((para) => <p>{para}</p>)}
                        </div>
                        <div class="stats reveal">
                            <div class="stat">
                                <b data-count={SITE.stats.students}>0</b><span>同 学</span>
                            </div>
                            <div class="stat">
                                <b data-count={SITE.stats.years}>0</b><span>年 时 光</span>
                            </div>
                            <div class="stat">
                                <b data-count={SITE.stats.days}>0</b><span>个 日 夜</span>
                            </div>
                            <div class="stat">
                                <b data-count={SITE.stats.memories}>0</b><span>+ 回 忆</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- ========== 时间轴 ========== -->
            <section id="timeline">
                <div class="container">
                    <div class="reveal">
                        <span class="sec-tag">Chronicle</span>
                        <h2 class="sec-title">班级<em>编年史</em></h2>
                        <p class="sec-desc">
                            从初见的那一天起，每一段日子都有了名字。
                        </p>
                    </div>
                    <div class="timeline"></div>
                </div>
            </section>
            <!-- ========== 班级人物 ========== -->
            <section id="people">
                <div class="container">
                    <div class="reveal">
                        <span class="sec-tag">The Crew</span>
                        <h2 class="sec-title">班级<em>人物志</em></h2>
                        <p class="sec-desc">那些撑起这个班的人。</p>
                    </div>

                    <div class="people">
                        {HOME.people.map((p) => (
                            <div class="person reveal">
                                <div class="avatar">{p.avatar}</div>
                                <h3>{p.title}</h3>
                                <div class="role">{p.role}</div>
                                <p class="quote">"{p.quote}"</p>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
            <!-- ========== 荣誉 ========== -->
            <section id="honor">
                <div class="container">
                    <div class="reveal">
                        <span class="sec-tag">Honors</span>
                        <h2 class="sec-title">班级<em>荣誉</em></h2>
                        <p class="sec-desc">属于我们共同的勋章。</p>
                    </div>
                    <div class="honors">
                        {HOME.honors.map((h) => (
                            <div class="honor reveal">
                                <div class="medal">{h.medal}</div>
                                <div>
                                    <h4>{h.title}</h4>
                                    <p>{h.detail}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
            <!-- ========== 记忆墙 ========== -->
            <section id="memory">
                <div class="container">
                    <div class="reveal">
                        <span class="sec-tag">Memories</span>
                        <h2 class="sec-title">班级<em>记忆</em></h2>
                        <p class="sec-desc">
                            把这里替换成你们的照片吧 —— 将 &lt;div
                            class="photo"&gt; 换成 &lt;img&gt; 或背景图即可。
                        </p>
                    </div>
                    <div class="gallery">
                        {HOME.gallery.map((label) => (
                            <div class="photo reveal"><span>{label}</span></div>
                        ))}
                    </div>
                </div>
            </section>
            <!-- ========== 留言墙 ========== -->
            <section id="board">
                <div class="container">
                    <div class="reveal">
                        <span class="sec-tag">Message Board</span>
                        <h2 class="sec-title">留<em>言</em>墙</h2>
                        <p class="sec-desc">写下一句话，送给未来的我们。</p>
                    </div>
                    <div class="msg-form reveal">
                        <input
                            id="msgName"
                            type="text"
                            maxlength="12"
                            placeholder="你的名字"
                        />
                        <textarea
                            id="msgText"
                            maxlength="120"
                            placeholder={`想对${SITE.classShort}说点什么……`}></textarea>
                        <button id="msgSend">留 言</button>
                    </div>
                    <div class="msg-list" id="msgList"></div>
                </div>
            </section>
            <!-- ========== 页脚 ========== -->
            <footer>
                <div class="sig">{SITE.className} · 永远</div>
                <p>愿我们都被世界温柔以待，也永远记得这间教室</p>
                <p class="small">© {SITE.className}班史 · 制作于某个想起你们的夜晚</p>
            </footer>
        </div>
        <button id="top" aria-label="回到顶部">↑</button>
        <!-- <Footer /> -->
        <script
            type="application/json"
            id="typed-lines"
            set:html={JSON.stringify(HOME.typedLines).replace(/</g, "\\u003c")}
        />
        <script src="/js/index.js" is:inline></script>
    </body>
</html>
