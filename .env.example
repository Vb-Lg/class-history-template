# 复制为 .env 使用。注意：
# - PUBLIC_TURNSTILE_SITE_KEY 是构建时变量，本地构建需要；
# - GITHUB_* / TURNSTILE_SECRET_KEY 是 Pages Functions 的运行时变量：
#   线上须在 Pages 控制台配置（本地 .env 不会随部署上传）；
#   本地调试 API（npx wrangler pages dev dist）时 wrangler 会自动读取本文件。

# ---- 投稿后端：GitHub App（详见 README「创建 GitHub App」一节） ----
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_OWNER=
GITHUB_REPO=

# ---- 可选覆盖项（不填使用 functions/api/submit.ts 里的默认值） ----
# GITHUB_BASE_BRANCH=main
# CONTENT_DIR=src/content
# MEDIA_DIR=public/pages/static
# MEDIA_URL_PREFIX=/pages/static
# SONGS_DIR=src/songs

# ---- 可选：Cloudflare Turnstile 人机验证（两个都配置才启用） ----
# TURNSTILE_SECRET_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=
